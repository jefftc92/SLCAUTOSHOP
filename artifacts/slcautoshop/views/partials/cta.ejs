<section class="cta-section">
  <div class="container">
    <h2><%= typeof ctaTitle !== 'undefined' ? ctaTitle : 'Ready for Quality Auto Repair?' %></h2>
    <p><%= typeof ctaDesc !== 'undefined' ? ctaDesc : "Contact Scott's Auto & Clutch Repair today for honest service and expert repairs." %></p>
    <div class="cta-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>" class="btn btn-secondary">Text Us</a>
    </div>
    <p class="cta-address"><%= site.fullAddress %></p>
  </div>
</section>
