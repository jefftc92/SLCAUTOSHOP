<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Vehicle Brands',url:'/vehicle-brands'},{label:brand.name}]}) %>

<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('<%= brand.heroImage || site.heroImage %>')"></div>
  <div class="container">
    <h1><%= brand.heading %></h1>
    <p><%= brand.intro %></p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent('Hi, I need service for my ' + brand.name + '.') %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<% if (brandContent && brandContent.whoContent) { %>
<%# ============================================================
     v2 LAYOUT — WHAT / WHY / WHEN / WHO / HOW / WHERE / FAQ / ...
     ============================================================ %>
<% var _sec = 0; %>

<%# 1. WHAT — Vehicles We Service %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= brandContent.whatHeading || (brand.name + ' Vehicles We Service') %></h2>
    <% if (brandContent.whatIntro) { %>
    <div class="prose" style="max-width:760px;margin-bottom:1.5rem">
      <p><%- brandContent.whatIntro %></p>
    </div>
    <% } %>
    <div class="brand-tags" style="margin-top:1.25rem">
      <% brand.models.forEach(m => { %>
      <span class="tag"><%= brand.name %> <%= m %></span>
      <% }) %>
    </div>
    <p style="margin-top:1.25rem">Have questions about your specific <%= brand.name %>? Give us a call or send a quick text — we're happy to help.</p>
    <div class="hero-buttons" style="margin-top:1.25rem">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent('Hi, I need service for my ' + brand.name + '.') %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<%# 2. WHY — Why Drivers Choose Us %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Why <%= brand.name %> Drivers Choose Scott's</h2>
    <% if (brandContent.whyIntro) { %>
    <div class="prose" style="max-width:760px;margin-bottom:2rem">
      <p><%- brandContent.whyIntro %></p>
    </div>
    <% } %>
    <div class="values-grid">
      <% brandContent.whyUs.forEach(v => { %>
      <div class="value-card">
        <h3><%= v.title %></h3>
        <p><%= v.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<%# 3. WHEN — When to Come In %>
<% if (brandContent.whenContent && brandContent.whenContent.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>When to Bring Your <%= brand.name %> In</h2>
    <div class="prose" style="max-width:760px">
      <% brandContent.whenContent.forEach(function(p) { %><p><%- p %></p><% }); %>
    </div>
  </div>
</section>
<% } %>

<%# 4. WHO — Who to Trust %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= brandContent.whoContent.heading %></h2>
    <div class="prose" style="max-width:760px">
      <% brandContent.whoContent.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
    </div>
  </div>
</section>

<%# 5. HOW — How We Work With You %>
<% if (brandContent.process && brandContent.process.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>How We Work With <%= brand.name %> Drivers</h2>
    <% if (brandContent.processIntro) { %>
    <p class="section-subtitle"><%- brandContent.processIntro %></p>
    <% } %>
    <div class="process-steps-compact">
      <% brandContent.process.forEach(p => { %>
      <div class="process-step-compact">
        <span class="step-num"><%= p.step %></span>
        <div>
          <h3><%= p.title %></h3>
          <p><%= p.desc %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%# 6. WHERE — Map & Address %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Where to Find Us</h2>
    <p>Scott's Auto &amp; Clutch Repair is located at 144 W Crystal Ave in South Salt Lake — centrally positioned in the valley, within 15 minutes of most Salt Lake City zip codes. Easy to reach from I-15, serving <%= brand.name %> drivers from Millcreek, Murray, Draper, Sandy, West Jordan, Taylorsville, and across the greater Salt Lake area.</p>
    <div class="symptom-location-grid" style="margin-top:1.5rem">
      <div class="symptom-location-info">
        <div class="location-detail">
          <h3>Address</h3>
          <p><a href="<%= site.directionsUrl %>" target="_blank" rel="noopener"><%= site.fullAddress %></a></p>
        </div>
        <div class="location-detail">
          <h3>Hours</h3>
          <p><%= site.hours %></p>
        </div>
        <div class="location-detail">
          <h3>Phone</h3>
          <p><a href="tel:<%= site.phoneTel %>"><%= site.phone %></a></p>
        </div>
        <div class="symptom-location-actions">
          <a href="<%= site.directionsUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Get Directions</a>
          <a href="tel:<%= site.phoneTel %>" class="btn btn-secondary">Call Us</a>
        </div>
      </div>
      <div class="symptom-location-map">
        <iframe
          src="https://maps.google.com/maps?q=144+W+Crystal+Ave,+South+Salt+Lake,+UT+84117&output=embed&hl=en&z=15"
          width="100%" height="100%"
          style="border:0;border-radius:var(--radius);min-height:320px"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Auto & Clutch Repair Location Map">
        </iframe>
      </div>
    </div>
  </div>
</section>

<%# 7. FAQ %>
<% var faqAlt = !!(_sec++ % 2); %>
<%- include('partials/faq') %>

<%# 8. Common Repairs (linked services) %>
<% if (brandContent.commonRepairs && brandContent.commonRepairs.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Common <%= brand.name %> Repairs</h2>
    <% if (brandContent.commonRepairsIntro) { %>
    <p class="section-subtitle"><%- brandContent.commonRepairsIntro %></p>
    <% } %>
    <div class="services-grid small">
      <% brandContent.commonRepairs.forEach(r => { %>
      <a href="/services/<%= r.slug %>" class="service-card">
        <h3><%= r.name %></h3>
        <span class="card-p"><%= r.desc %></span>
        <span class="card-link">View service</span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%# 9. Maintenance Tips %>
<% if (brandContent.tips && brandContent.tips.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= brand.name %> Maintenance Tips for Utah Drivers</h2>
    <p class="section-subtitle">Utah's temperature swings, mountain roads, and high altitude put unique demands on your vehicle. Here's what we've learned from years of servicing <%= brand.name %>s in the Salt Lake Valley.</p>
    <div class="tips-grid">
      <% brandContent.tips.forEach(tip => { %>
      <div class="tip-card">
        <p><%= tip %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%# 10. Service Areas %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= brand.name %> Repair Service Areas</h2>
    <p class="section-subtitle">Our shop in South Salt Lake is centrally located in the valley — most customers are within 15 minutes. We service <%= brand.name %> drivers from throughout the greater Salt Lake area.</p>
    <div class="locations-grid-compact" style="margin-top:1rem">
      <% allLocations.forEach(l => { %>
      <a href="/locations/<%= l.slug %>" class="location-tag">
        <strong><%= l.name %>, UT</strong>
        <span><%= l.isHome ? 'Our Location' : l.driveTime + ' away' %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<%# 11. Testimonials %>
<%- include('partials/testimonials') %>

<%# 12. Other Brands — always white to contrast testimonials' fixed alt-bg %>
<section class="content-section">
  <div class="container">
    <h2>Other Vehicle Brands We Service</h2>
    <div class="brand-tags">
      <% allVehicleBrands.filter(v => v.slug !== brand.slug).slice(0, 15).forEach(v => { %>
      <a href="/vehicle-brands/<%= v.slug %>" class="tag"><%= v.name %></a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/vehicle-brands" class="btn btn-outline">View All Brands</a>
    </div>
  </div>
</section>

<% } else { %>
<%# ============================================================
     LEGACY LAYOUT — preserved for brands not yet migrated to v2
     ============================================================ %>

<!-- 1. Why Choose Us — white -->
<section class="values-section">
  <div class="container">
    <h2>Why <%= brand.name %> Drivers Choose Us</h2>
    <div class="values-grid">
      <% const whyUsItems = (brandContent && brandContent.whyUs && brandContent.whyUs.length) ? brandContent.whyUs : [
        { title: "35+ Years Experience", desc: "Our technicians have decades of hands-on experience working on all vehicle makes and models." },
        { title: "Quality Parts", desc: "We use OEM and quality aftermarket parts that meet or exceed manufacturer specifications." },
        { title: "Same-Day Service", desc: "Many repairs completed same-day. We respect your time and work efficiently." },
        { title: "Honest Pricing", desc: "No surprises. We provide upfront quotes and explain every repair before we start." }
      ]; whyUsItems.forEach(v => { %>
      <div class="value-card">
        <h3><%= v.title %></h3>
        <p><%= v.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 2. Models We Service — alt-bg -->
<section class="content-section alt-bg">
  <div class="container">
    <h2><%= brand.name %> Vehicles We Service</h2>
    <p class="section-subtitle">These are some of the <%= brand.name %> vehicles we work on most often at our South Salt Lake shop. We service all <%= brand.name %> models — if yours isn't listed, that just means we don't see it every day.</p>
    <div class="brand-tags" style="margin-top:1.25rem">
      <% brand.models.forEach(m => { %>
      <span class="tag"><%= brand.name %> <%= m %></span>
      <% }) %>
    </div>
    <p style="margin-top:1.25rem">Have questions about your specific <%= brand.name %>? Give us a call or send a quick text — we're happy to help.</p>
    <div class="hero-buttons" style="margin-top:1.25rem">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent('Hi, I need service for my ' + brand.name + '.') %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<% if (brandContent && brandContent.richContent && brandContent.richContent.length) { %>
<% brandContent.richContent.forEach(function(sec, i) { %>
<section class="content-section<%= i % 2 === 0 ? '' : ' alt-bg' %>">
  <div class="container">
    <div class="prose" style="max-width:760px">
      <h2><%= sec.heading %></h2>
      <% sec.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec.list && sec.list.length) { %>
      <ul>
        <% sec.list.forEach(function(item) { %><li><%- item %></li><% }); %>
      </ul>
      <% } %>
    </div>
  </div>
</section>
<% }); %>
<% } else { %>
<section class="content-section">
  <div class="container">
    <h2>Our <%= brand.name %> Repair Capabilities</h2>
    <div class="prose" style="max-width:720px">
      <p>We handle the full range of mechanical repairs for <%= brand.name %> vehicles — clutch and transmission, brakes, CV axles, timing components, exhaust, cooling, and more. Every job starts with a free diagnosis so you know exactly what your vehicle needs before any work begins.</p>
      <p><a href="/services">View our full list of services</a> — if you have a question about a specific repair or aren't sure whether we can help, give us a call or text and we'll give you a straight answer.</p>
    </div>
    <div class="hero-buttons" style="margin-top:1.5rem">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent('Hi, I have a question about my ' + brand.name + '.') %>" class="btn btn-secondary">Text a Question</a>
    </div>
  </div>
</section>
<% } %>

<!-- 4. Services & Issues — alt-bg -->
<% if (brandContent && brandContent.issues && brandContent.issues.length) { %>
<section class="content-section alt-bg">
  <div class="container">
    <h2><%= (brandContent.issuesHeading) || ('Common ' + brand.name + ' Issues We Repair') %></h2>
    <p class="section-subtitle"><%= (brandContent.issuesSubtitle) || ('These are the most frequent ' + brand.name + ' problems we diagnose and repair at our South Salt Lake shop. Every job starts with a thorough diagnosis so you know exactly what\'s going on before any work begins.') %></p>
    <div class="issues-grid">
      <% brandContent.issues.forEach(issue => { %>
      <div class="issue-card">
        <h3><%= issue.t %></h3>
        <p><%= issue.d %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- 5. Maintenance Tips — white -->
<% if (brandContent && brandContent.tips && brandContent.tips.length) { %>
<section class="content-section">
  <div class="container">
    <h2><%= brand.name %> Maintenance Tips for Utah Drivers</h2>
    <p class="section-subtitle">Utah's temperature swings, mountain roads, and high altitude put unique demands on your vehicle. Here's what we've learned from years of servicing <%= brand.name %>s in the Salt Lake Valley.</p>
    <div class="tips-grid">
      <% brandContent.tips.forEach(tip => { %>
      <div class="tip-card">
        <p><%= tip %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- 6. FAQ — alt-bg (passed from server via faqAlt:true) -->
<%- include('partials/faq') %>

<!-- 7. Service Areas — white (alternates with grey FAQ above) -->
<section class="content-section">
  <div class="container">
    <h2><%= brand.name %> Repair Service Areas</h2>
    <p class="section-subtitle">Our shop in South Salt Lake is centrally located in the valley — most customers are within 15 minutes. We service <%= brand.name %> drivers from throughout the greater Salt Lake area.</p>
    <div class="locations-grid-compact" style="margin-top:1rem">
      <% allLocations.forEach(l => { %>
      <a href="/locations/<%= l.slug %>" class="location-tag">
        <strong><%= l.name %>, UT</strong>
        <span><%= l.isHome ? 'Our Location' : l.driveTime + ' away' %></span>
      </a>
      <% }) %>
    </div>
    <div style="margin-top:2rem">
      <a href="<%= site.directionsUrl %>" class="btn btn-outline" target="_blank" rel="noopener">Get Directions</a>
    </div>
  </div>
</section>

<!-- 8. Other Brands — alt-bg (alternates with white Service Areas above) -->
<section class="content-section alt-bg">
  <div class="container">
    <h2>Other Vehicle Brands We Service</h2>
    <div class="brand-tags">
      <% allVehicleBrands.filter(v => v.slug !== brand.slug).slice(0, 15).forEach(v => { %>
      <a href="/vehicle-brands/<%= v.slug %>" class="tag"><%= v.name %></a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/vehicle-brands" class="btn btn-outline">View All Brands</a>
    </div>
  </div>
</section>

<%- include('partials/testimonials') %>

<% } %>

<% var ctaTitle = "Need " + brand.name + " Repair?"; var ctaDesc = "Contact Scott's Auto & Clutch Repair today. Expert " + brand.name + " service at honest prices."; %>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
