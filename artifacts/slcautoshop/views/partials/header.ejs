<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof metaTitle !== 'undefined' ? metaTitle : site.name %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Expert auto repair in South Salt Lake, UT. Clutch repair, brake service, transmission work. Call (801) 485-4089.' %>">
  <link rel="canonical" href="<%= site.domain %><%= typeof canonical !== 'undefined' ? canonical : '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof structuredData !== 'undefined') { %>
  <% if (Array.isArray(structuredData)) { %>
  <% structuredData.forEach(sd => { %>
  <script type="application/ld+json"><%- JSON.stringify(sd) %></script>
  <% }) %>
  <% } else { %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } %>
  <% } %>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo-link">
        <img src="<%= site.headerLogo %>" alt="Scott's Auto and Clutch logo" class="header-logo" style="height:80px;width:auto" loading="eager">
      </a>
      <button class="mobile-menu-btn" aria-label="Toggle menu" onclick="document.body.classList.toggle('nav-open')">
        <span></span><span></span><span></span>
      </button>
      <nav class="main-nav">

        <a href="/" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'home' ? ' active' : '' %>">Home</a>

        <!-- Symptoms Dropdown -->
        <div class="nav-item">
          <a href="/symptoms" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'symptoms' ? ' active' : '' %>" onclick="this.parentElement.classList.toggle('mobile-open')">
            Symptoms <i class="arrow"></i>
          </a>
          <div class="nav-dropdown wide">
            <div class="dd-label">By Category</div>
            <div class="dd-columns">
              <div>
                <a href="/symptoms/clutch-slipping-repair-south-salt-lake">Clutch Slipping</a>
                <a href="/symptoms/grinding-noise-shifting-repair-south-salt-lake">Grinding When Shifting</a>
                <a href="/symptoms/burning-smell-clutch-repair-south-salt-lake">Burning Smell</a>
                <a href="/symptoms/clicking-noise-turning-repair-south-salt-lake">Clicking When Turning</a>
                <a href="/symptoms/check-engine-light-repair-south-salt-lake">Check Engine Light</a>
                <a href="/symptoms/engine-overheating-repair-south-salt-lake">Engine Overheating</a>
              </div>
              <div>
                <a href="/symptoms/squeaking-brakes-repair-south-salt-lake">Squeaking Brakes</a>
                <a href="/symptoms/grinding-brakes-repair-south-salt-lake">Grinding Brakes</a>
                <a href="/symptoms/soft-brake-pedal-repair-south-salt-lake">Soft Brake Pedal</a>
                <a href="/symptoms/bouncy-ride-repair-south-salt-lake">Bouncy Ride</a>
                <a href="/symptoms/loud-exhaust-repair-south-salt-lake">Loud Exhaust</a>
                <a href="/symptoms/failed-emissions-repair-south-salt-lake">Failed Emissions</a>
              </div>
            </div>
            <div class="dd-divider"></div>
            <a href="/symptoms" class="dd-viewall">View All Symptoms →</a>
          </div>
        </div>

        <!-- Services Dropdown -->
        <div class="nav-item">
          <a href="/services" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'services' ? ' active' : '' %>" onclick="this.parentElement.classList.toggle('mobile-open')">
            Services <i class="arrow"></i>
          </a>
          <div class="nav-dropdown">
            <a href="/services/clutch-repair-south-salt-lake-ut">Clutch Repair</a>
            <a href="/services/cv-joint-repair-south-salt-lake-ut">CV Joint Repair</a>
            <a href="/services/brake-service-south-salt-lake-ut">Brake Service</a>
            <a href="/services/timing-chain-repair-south-salt-lake-ut">Timing Chain</a>
            <a href="/services/timing-belt-replacement-south-salt-lake-ut">Timing Belt</a>
            <a href="/services/water-pump-replacement-south-salt-lake-ut">Water Pump</a>
            <a href="/services/exhaust-repair-south-salt-lake-ut">Exhaust Repair</a>
            <a href="/services/catalytic-converter-service-south-salt-lake-ut">Catalytic Converter</a>
            <a href="/services/strut-replacement-south-salt-lake-ut">Struts</a>
            <a href="/services/shock-replacement-south-salt-lake-ut">Shocks</a>
            <a href="/services/welding-services-south-salt-lake-ut">Welding</a>
            <a href="/services/complete-auto-service-south-salt-lake-ut">Complete Auto Service</a>
            <div class="dd-divider"></div>
            <a href="/services" class="dd-viewall">View All Services →</a>
          </div>
        </div>

        <!-- Vehicles Dropdown -->
        <div class="nav-item">
          <a href="/vehicle-brands" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'vehicles' ? ' active' : '' %>" onclick="this.parentElement.classList.toggle('mobile-open')">
            Vehicles <i class="arrow"></i>
          </a>
          <div class="nav-dropdown wide">
            <div class="dd-label">Popular Brands</div>
            <div class="dd-columns">
              <div>
                <a href="/vehicle-brands/toyota-repair-salt-lake-city-ut">Toyota</a>
                <a href="/vehicle-brands/honda-repair-salt-lake-city-ut">Honda</a>
                <a href="/vehicle-brands/ford-repair-salt-lake-city-ut">Ford</a>
                <a href="/vehicle-brands/chevrolet-repair-salt-lake-city-ut">Chevrolet</a>
                <a href="/vehicle-brands/subaru-repair-salt-lake-city-ut">Subaru</a>
                <a href="/vehicle-brands/nissan-repair-salt-lake-city-ut">Nissan</a>
              </div>
              <div>
                <a href="/vehicle-brands/bmw-repair-salt-lake-city-ut">BMW</a>
                <a href="/vehicle-brands/jeep-repair-salt-lake-city-ut">Jeep</a>
                <a href="/vehicle-brands/dodge-repair-salt-lake-city-ut">Dodge</a>
                <a href="/vehicle-brands/hyundai-repair-salt-lake-city-ut">Hyundai</a>
                <a href="/vehicle-brands/kia-repair-salt-lake-city-ut">Kia</a>
                <a href="/vehicle-brands/volkswagen-repair-salt-lake-city-ut">Volkswagen</a>
              </div>
            </div>
            <div class="dd-divider"></div>
            <a href="/vehicle-brands" class="dd-viewall">View All 40+ Brands →</a>
          </div>
        </div>

        <a href="/about" class="nav-link<%= typeof activePage !== 'undefined' && activePage === 'about' ? ' active' : '' %>">About</a>

        <a href="tel:<%= site.phoneTel %>" class="nav-phone"><%= site.phone %></a>
      </nav>
    </div>
  </header>
