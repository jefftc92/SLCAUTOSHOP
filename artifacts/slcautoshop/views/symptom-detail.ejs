<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Symptoms Guide',url:'/symptoms'},{label:symptom.shortName}]}) %>

<section class="page-hero">
  <style nonce="<%= cspNonce %>">.page-hero-bg{background-image:url('/assets/hero-600-DnXM3vMX.webp')}</style>
  <div class="page-hero-bg"></div>
  <div class="container">
    <span class="symptom-priority priority-<%= symptom.priority.toLowerCase() %>"><%= symptom.priority %> Priority</span>
    <h1><%= symptom.name %> — Repair in Salt Lake City, UT</h1>
    <% if (symptom.heroIntro) { %>
    <p class="hero-intro"><%= symptom.heroIntro %></p>
    <% } %>
    <% if (symptom.lastUpdated) { %>
    <p class="hero-meta">Last updated <%= symptom.lastUpdated %></p>
    <% } %>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="prose mw-760">
      <h2>What Is <%= symptom.shortName %>?</h2>
      <p class="intro-lead"><%= symptom.intro %></p>
      <% if (symptom.introImage) { %>
      <figure class="prose-figure">
        <img src="/assets/<%= symptom.introImage %>" alt="<%= symptom.introImageAlt %>" class="prose-image" width="760" height="428" loading="lazy">
        <% if (symptom.introImageCaption) { %>
        <figcaption class="prose-figcaption"><%= symptom.introImageCaption %></figcaption>
        <% } %>
      </figure>
      <% } %>
    </div>
  </div>
</section>

<% if (symptom.richContent && symptom.richContent.length) { %>
<% var howToSec = symptom.richContent[0]; %>
<section class="content-section alt-bg">
  <div class="container">
    <div class="prose mw-760<%= howToSec.image ? ' prose-with-image' : '' %>">
      <h2><%= howToSec.heading %></h2>
      <% if (howToSec.image) { %>
      <img src="/assets/<%= howToSec.image %>" alt="<%= howToSec.imageAlt %>" class="prose-image" width="760" height="428" loading="lazy">
      <% } %>
      <% howToSec.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="content-section">
  <div class="container">
    <h2>Why Is My <%= symptom.shortName %>?</h2>
    <p class="section-subtitle">These are the most common causes. The "How to tell" note on each card describes what that cause typically feels or sounds like so you can narrow down which one applies to your vehicle.</p>
    <div class="issues-grid">
      <% symptom.causes.forEach(c => { %>
      <div class="issue-card">
        <h3><%= c.title %></h3>
        <p><%= c.desc %></p>
        <% if (c.diagnosticSignal) { %>
        <div class="diagnostic-signal">
          <span class="diagnostic-label">How to tell</span>
          <p><%= c.diagnosticSignal %></p>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <p class="inline-cta mt-6">Not sure which applies to you? <a href="tel:<%= site.phoneTel %>">Call <%= site.phone %></a> or <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>">text us</a> — free diagnosis at our Salt Lake City shop.</p>
  </div>
</section>

<% if (symptom.richContent && symptom.richContent.length > 1) { %>
<% symptom.richContent.slice(1).forEach(function(sec, i) { %>
<section class="content-section<%= i % 2 === 0 ? ' alt-bg' : '' %>">
  <div class="container">
    <div class="prose mw-760<%= sec.image ? ' prose-with-image' : '' %>">
      <h2><%= sec.heading %></h2>
      <% if (sec.image) { %>
      <img src="/assets/<%= sec.image %>" alt="<%= sec.imageAlt %>" class="prose-image" width="760" height="428" loading="lazy">
      <% } %>
      <% sec.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec.list && sec.list.length) { %>
      <ul>
        <% sec.list.forEach(function(item) { %><li><%- item %></li><% }); %>
      </ul>
      <% } %>
      <% if (sec.inlineCta) { %>
      <div class="section-cta-block">
        <p>Free diagnosis. Written estimate before any work begins. No surprises.</p>
        <div class="section-cta-buttons">
          <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
          <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-secondary">Text Us</a>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% }); %>
<% } %>

<section class="content-section alt-bg symptom-location-section">
  <div class="container">
    <h2>Where to Get Your <%= symptom.shortName %> Fixed</h2>
    <p class="section-subtitle">Scott's Auto &amp; Clutch Repair — serving Salt Lake City drivers since 1990.</p>
    <div class="symptom-location-grid">
      <div class="symptom-location-info">
        <div class="location-detail">
          <h3>Address</h3>
          <p><a href="<%= site.directionsUrl %>" target="_blank" rel="noopener"><%= site.fullAddress %></a></p>
        </div>
        <div class="location-detail">
          <h3>Hours</h3>
          <p><%= site.hours %></p>
        </div>
        <div class="location-detail">
          <h3>Phone</h3>
          <p><a href="tel:<%= site.phoneTel %>"><%= site.phone %></a></p>
        </div>
        <div class="symptom-location-actions">
          <a href="<%= site.directionsUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Get Directions</a>
          <a href="tel:<%= site.phoneTel %>" class="btn btn-secondary">Call Us</a>
          <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-outline">Text Us</a>
        </div>
      </div>
      <div class="symptom-location-map">
        <iframe
          src="https://maps.google.com/maps?q=144+W+Crystal+Ave,+South+Salt+Lake,+UT+84115&output=embed&hl=en&z=15"
          width="100%" height="100%"
          class="map-embed map-embed--sm"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Auto & Clutch Repair Location Map">
        </iframe>
      </div>
    </div>
  </div>
</section>

<% var faqAlt = false; %>
<%- include('partials/faq') %>

<section class="content-section<%= faqAlt ? '' : ' alt-bg' %>">
  <div class="container">
    <h2>Not Sure This Is Your Issue?</h2>
    <p class="section-subtitle">Browse related symptoms — drivers often confuse these for one another.</p>
    <div class="symptom-other-grid">
      <% relatedSymptoms.forEach(sy => { %>
      <a href="/symptoms/<%= sy.slug %>" class="symptom-other-card cat-<%= sy.category.toLowerCase().replace(' ','') %>">
        <span class="symptom-cat-chip"><%= sy.category %></span>
        <strong><%= sy.shortName %></strong>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/symptoms" class="btn btn-outline">View All Symptoms Guide</a>
    </div>
  </div>
</section>

<%- include('partials/testimonials') %>

<%- include('partials/cta') %>
<%- include('partials/footer') %>
