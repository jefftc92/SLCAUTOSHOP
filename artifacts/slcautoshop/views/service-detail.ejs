<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Services',url:'/services'},{label:service.name}]}) %>

<section class="page-hero">
  <style nonce="<%= cspNonce %>">.page-hero-bg{background-image:url('<%= service.heroImage %>')}</style>
  <div class="page-hero-bg"></div>
  <div class="container">
    <h1><%= service.heading || service.metaTitle %></h1>
    <% if (service.heroIntro) { %>
    <p class="hero-intro"><%= service.heroIntro %></p>
    <% } %>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<% var _sec = 0; %>

<% if (service.statsTable && service.statsTable.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= service.name %> — At a Glance</h2>
    <div class="stats-table-wrap stats-wrap-service">
      <table class="stats-table">
        <tbody>
          <% service.statsTable.forEach(function(row) { %>
          <tr>
            <th scope="row"><%= row.label %></th>
            <td><%= row.value %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% } %>

<% if (service.intro || service.introImage) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <div class="prose mw-760">
      <% if (service.intro) { %><p class="intro-lead"><%= service.intro %></p><% } %>
      <% if (service.introImage) { %>
      <figure class="prose-figure">
        <img src="/assets/<%= service.introImage %>" alt="<%= service.introImageAlt %>" class="prose-image" width="760" height="428" loading="lazy">
        <% if (service.introImageCaption) { %>
        <figcaption class="prose-figcaption"><%= service.introImageCaption %></figcaption>
        <% } %>
      </figure>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (service.specializedServices && service.specializedServices.length && !service.hideServicesSection) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Our <%= service.name %> Services</h2>
    <p class="section-subtitle">Every repair starts with a thorough diagnosis. We identify exactly what your vehicle needs, walk you through our findings, and get your approval before any work begins. Depending on what we find, the types of work we commonly perform include:</p>
    <div class="brand-tags mt-5">
      <% service.specializedServices.forEach(ss => { %>
      <span class="tag"><%= ss %></span>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (service.richContent && service.richContent.length) { %>
<% service.richContent.forEach(function(sec) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <div class="prose mw-760">
      <h2><%= sec.heading %></h2>
      <% sec.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec.list && sec.list.length) { %>
      <% if (sec.listStyle === 'tags') { %>
      <div class="brand-tags mt-4">
        <% sec.list.forEach(function(item) { %><span class="tag"><%- item %></span><% }); %>
      </div>
      <% } else { %>
      <ul>
        <% sec.list.forEach(function(item) { %><li><%- item %></li><% }); %>
      </ul>
      <% } %>
      <% } %>
    </div>
  </div>
</section>
<% }); %>
<% } %>

<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= service.processHeading || 'How a ' + service.name + ' Repair Works' %></h2>
    <% if (service.processIntro) { %>
    <p class="section-subtitle"><%= service.processIntro %></p>
    <% } %>
    <div class="process-steps-compact">
      <% service.process.forEach(p => { %>
      <div class="process-step-compact">
        <span class="step-num"><%= p.step %></span>
        <div>
          <h3><%= p.title %></h3>
          <p><%= p.desc %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (service.whoContent) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2><%= service.whoContent.heading %></h2>
    <div class="prose mw-760 mb-8">
      <% service.whoContent.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
    </div>
    <div class="values-grid">
      <% service.whyUs.forEach(w => { %>
      <div class="value-card">
        <h3><%= w.title %></h3>
        <p><%= w.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } else { _sec++; %>
<section class="values-section">
  <div class="container">
    <h2>Why Choose Scott's for <%= service.name %>?</h2>
    <div class="values-grid">
      <% service.whyUs.forEach(w => { %>
      <div class="value-card">
        <h3><%= w.title %></h3>
        <p><%= w.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Where to Find Us</h2>
    <p>Scott's Auto &amp; Clutch Repair is located at 144 W Crystal Ave in South Salt Lake — centrally positioned in the valley, within 15 minutes of most Salt Lake City zip codes. Easy to reach from I-15, serving drivers from Millcreek, Murray, Draper, Sandy, West Jordan, Taylorsville, and across the greater Salt Lake area.</p>
    <div class="symptom-location-grid mt-6">
      <div class="symptom-location-info">
        <div class="location-detail">
          <h3>Address</h3>
          <p><a href="<%= site.directionsUrl %>" target="_blank" rel="noopener"><%= site.fullAddress %></a></p>
        </div>
        <div class="location-detail">
          <h3>Hours</h3>
          <p><%= site.hours %></p>
        </div>
        <div class="location-detail">
          <h3>Phone</h3>
          <p><a href="tel:<%= site.phoneTel %>"><%= site.phone %></a></p>
        </div>
        <div class="symptom-location-actions">
          <a href="<%= site.directionsUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Get Directions</a>
          <a href="tel:<%= site.phoneTel %>" class="btn btn-secondary">Call Us</a>
        </div>
      </div>
      <div class="symptom-location-map">
        <iframe
          src="https://maps.google.com/maps?q=144+W+Crystal+Ave,+South+Salt+Lake,+UT+84115&output=embed&hl=en&z=15"
          width="100%" height="100%"
          class="map-embed map-embed--sm"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Auto & Clutch Repair Location Map">
        </iframe>
      </div>
    </div>
    <% if (allGeoPages && allGeoPages.length && service.slug === 'clutch-repair-near-south-salt-lake-ut') { %>
    <div class="locations-grid-compact mt-8">
      <% allGeoPages.forEach(g => { %>
      <a href="/services/<%= g.slug %>" class="location-tag">
        <strong><%= g.locationName %></strong>
        <span><%= g.distance %> · <%= g.driveTime %> drive</span>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="locations-grid-compact mt-8">
      <% var _serviceBase = service.slug.replace(/-near-south-salt-lake-ut$/, ''); %>
      <% allLocations.filter(l => !l.isHome).forEach(l => { %>
      <% var _citySlug = l.slug.replace(/-ut-auto-repair$/, ''); %>
      <% var _geoHref = '/services/' + _serviceBase + '-near-' + _citySlug + '-ut'; %>
      <a href="<%= _geoHref %>" class="location-tag">
        <strong><%= l.name %>, UT</strong>
        <span><%= l.driveTime %> away</span>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<% if (service.commonIssues && service.commonIssues.length) { %>
<section class="content-section<%= _sec++ % 2 ? ' alt-bg' : '' %>">
  <div class="container">
    <h2>Symptoms That Bring Drivers In</h2>
    <div class="issues-grid">
      <% service.commonIssues.forEach(issue => { %>
      <div class="issue-card">
        <% if (issue.symptomSlug) { %>
        <h3><a href="/symptoms/<%= issue.symptomSlug %>" class="issue-link"><%= issue.title %></a></h3>
        <% } else { %>
        <h3><%= issue.title %></h3>
        <% } %>
        <p><%= issue.desc %></p>
        <% if (issue.symptomSlug) { %>
        <a href="/symptoms/<%= issue.symptomSlug %>" class="card-link-sm">See symptom details →</a>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% var faqAlt = !!(service.commonIssues && service.commonIssues.length); %>
<%- include('partials/faq') %>

<% if (relatedServices && relatedServices.length) { %>
<section class="content-section alt-bg">
  <div class="container">
    <h2>Related Services</h2>
    <div class="services-grid small">
      <% relatedServices.forEach(rs => { %>
      <a href="/services/<%= rs.slug %>" class="service-card">
        <h3><%= rs.name %></h3>
        <span class="card-p"><%= rs.shortDesc %></span>
        <span class="card-link">View service</span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/testimonials') %>

<% var ctaTitle = "Get a " + service.name + " Estimate"; var ctaDesc = "Contact Scott's Auto & Clutch Repair today for a free diagnosis. We'll get your vehicle running right."; %>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
