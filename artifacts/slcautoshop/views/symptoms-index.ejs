<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Symptoms Guide'}]}) %>

<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('<%= site.symptomsHeroImage %>')"></div>
  <div class="container">
    <h1>Car Symptoms Guide — What's Wrong With My Car?</h1>
    <p>Noticing something unusual with your vehicle? Browse our symptom guide to understand what might be happening, and contact us for a free diagnosis.</p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <% var categories = [...new Set(allSymptoms.map(s => s.category))]; %>
    <% categories.forEach(cat => { %>
    <div class="symptom-category">
      <h2><%= cat %> Symptoms</h2>
      <div class="symptoms-grid">
        <% allSymptoms.filter(s => s.category === cat).forEach(sy => { %>
        <a href="/symptoms/<%= sy.slug %>" class="symptom-card cat-<%= sy.category.toLowerCase().replace(' ','') %>">
          <span class="symptom-cat-chip"><%= sy.category %></span>
          <h3><%= sy.name %></h3>
          <span class="card-link">Learn More</span>
        </a>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<%- include('partials/cta') %>
<%- include('partials/footer') %>
