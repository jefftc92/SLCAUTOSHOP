<%- include('partials/header') %>

<section class="hero">
  <style nonce="<%= cspNonce %>">.hero-bg{background-image:url('<%= site.heroImage %>')}</style>
  <div class="hero-bg"></div>
  <div class="container hero-content">
    <h1>Auto Repair in <span class="hero-accent">Salt Lake City</span></h1>
    <p class="hero-badge">Family-Owned Since 1990</p>
    <p class="hero-desc">Scott's Auto &amp; Clutch Repair is a family-owned shop at 144 W Crystal Ave in South Salt Lake, open since 1990. Clutch repair is still the specialty, along with brakes, exhaust, and the other repairs Salt Lake City drivers bring in. Open Monday through Friday, 9:00 AM to 5:30 PM. Call (801) 485-4089.</p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call Now</a>
      <a href="sms:<%= site.phoneTel %>" class="btn btn-secondary">Text For Quote</a>
    </div>
  </div>
</section>

<section class="services-section">
  <div class="container">
    <p class="section-label">What We Do</p>
    <h2>Auto Repair Services</h2>
    <div class="services-grid">
      <% services.slice(0, 8).forEach(s => { %>
      <a href="/services/<%= s.slug %>" class="service-card">
        <img src="<%= s.image %>" alt="<%= s.fullName %> service" loading="lazy" width="400" height="267">
        <h3><%= s.fullName %></h3>
        <span class="card-p"><%= s.shortDesc %></span>
        <span class="card-link">Learn More</span>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/services" class="btn btn-outline">Explore All Services</a>
    </div>
  </div>
</section>

<section class="values-section alt-bg">
  <div class="container">
    <p class="section-label">Our Promise</p>
    <h2>Why Customers Choose Scott's</h2>
    <div class="values-grid">
      <% [
        { title: "Diagnose First, Always", desc: "We never recommend a repair without a diagnosis. You get a clear explanation of what's wrong and why before we touch anything, no pressure, no guessing." },
        { title: "Clutch Specialists Since 1990", desc: "It's literally in our name. When your clutch slips or grinds, you want the shop that has spent over 35 years on manual transmissions, not one that sees clutches twice a year." },
        { title: "Flat Quotes, No Surprises", desc: "The number we give you before the job is the number on your invoice. We call before doing anything beyond the agreed scope, always." },
        { title: "Same or Next Day Service", desc: "Most clutch, brake, CV joint, and exhaust repairs are finished the same day you bring the car in. Drop off in the morning, pick up after work. If it needs more time, we'll tell you upfront." },
        { title: "2-Year Parts & Labor Warranty", desc: "Every repair we do is backed by a 2-year parts and labor warranty. We stand behind our work, if something we fixed gives you trouble, we make it right." },
        { title: "Free Towing on Major Repairs", desc: "If your repair totals over $1,000, we cover the tow. You shouldn't have to pay to get your car to the shop on top of dealing with the breakdown." }
      ].forEach(v => { %>
      <div class="value-card">
        <h3><%= v.title %></h3>
        <p><%= v.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="about-preview">
  <div class="container about-preview-inner">
    <div class="about-preview-text">
      <p class="section-label">Since 1990</p>
      <h2>Your Trusted Auto Mechanic in Salt Lake</h2>
      <p>Scott's Auto &amp; Clutch Repair has worked on cars in the Salt Lake Valley since 1990. Clutch repair and manual transmissions are the specialty. We also do brakes, exhaust, and the rest of a full-service shop.</p>
      <p>A slipping clutch, brake noise after the I-15 commute, or a car that needs regular work: bring it to 144 W Crystal Ave in South Salt Lake. We work on daily drivers, trucks, and performance cars.</p>
      <p>Over 35 years in South Salt Lake. We tell you what we found and what it costs before we start.</p>
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Contact Us Today</a>
    </div>
    <div class="stats-grid">
      <% [
        { num: "Over 35", label: "Years Experience" },
        { num: "1000s", label: "Repairs Completed" },
        { num: "5", label: "Star Rated" },
        { num: "All", label: "Makes & Models" }
      ].forEach(s => { %>
      <div class="stat-card">
        <span class="stat-num"><%= s.num %></span>
        <span class="stat-label"><%= s.label %></span>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/testimonials') %>

<section class="symptoms-preview">
  <div class="container">
    <p class="section-label">Symptoms Guide</p>
    <h2>Common Problems We Solve</h2>
    <p>Experiencing any of these issues? We can help diagnose and fix them.</p>
    <div class="symptom-tags">
      <% allSymptoms.slice(0, 8).forEach(sy => { %>
      <a href="/symptoms/<%= sy.slug %>" class="tag"><%= sy.shortName %></a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/symptoms" class="btn btn-outline">View All Symptoms Guide</a>
    </div>
  </div>
</section>

<section class="locations-preview alt-bg">
  <div class="container">
    <p class="section-label">Service Area</p>
    <h2>Serving the Salt Lake Valley</h2>
    <p>Conveniently located in South Salt Lake, serving communities throughout the valley.</p>
    <div class="locations-grid-compact">
      <% allLocations.slice(0, 8).forEach(l => { %>
      <a href="/locations/<%= l.slug %>" class="location-tag">
        <strong><%= l.name %></strong>
        <span><%= l.isHome ? 'Our Location' : l.driveTime + ' drive' %></span>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/locations" class="btn btn-outline">View All Service Areas</a>
    </div>
    <div class="location-map-row">
      <div class="location-info-box">
        <p><strong><%= site.fullAddress %></strong></p>
        <p><%= site.hours %><br><%= site.satHours %><br><%= site.sunHours %></p>
        <p>Call or text anytime</p>
        <div class="cta-buttons">
          <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call Now For Service</a>
          <a href="sms:<%= site.phoneTel %>" class="btn btn-secondary">Text For Quote</a>
        </div>
      </div>
      <div class="location-map">
        <iframe
          src="https://maps.google.com/maps?q=144+W+Crystal+Ave+South+Salt+Lake+UT+84115&t=&z=15&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="260"
          class="map-embed d-block"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Auto & Clutch Repair location map"></iframe>
      </div>
    </div>
  </div>
</section>

<section class="brands-preview">
  <div class="container">
    <p class="section-label">All Makes &amp; Models</p>
    <h2>Vehicle Brands We Service</h2>
    <p>Expert clutch, brake, and drivetrain service for all major manufacturers.</p>
    <div class="brands-grid">
      <% allVehicleBrands.filter(v => v.popular).slice(0, 12).forEach(v => { %>
      <a href="/vehicle-brands/<%= v.slug %>" class="brand-card">
        <img src="<%= v.logoUrl %>" alt="<%= v.name %> logo" class="brand-logo" loading="lazy" width="80" height="80">
        <h3><%= v.name %> Repair</h3>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/vehicle-brands" class="btn btn-outline">View All Vehicle Brands</a>
    </div>
  </div>
</section>

<%- include('partials/cta') %>
<%- include('partials/footer') %>
