<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Service Areas',url:'/locations'},{label:location.name}]}) %>

<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('<%= site.symptomsHeroImage %>')"></div>
  <div class="container">
    <h1><%= location.heading %></h1>
    <p><%= location.intro %></p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<!-- 1. Shop Info + Map — white -->
<section class="content-section">
  <div class="container">
    <h2><% if (!location.isHome) { %>Just <%= location.driveTime %> from <%= location.name %><% } else { %>Your South Salt Lake Auto Shop<% } %></h2>
    <div class="loc-shop-grid">
      <div class="loc-shop-info">
        <p><%- linkifyServices(location.whyChooseUs) %></p>
        <% if (locSeo && locSeo.keywordIntro) { %>
        <p style="margin-top:1rem"><%- linkifyServices(locSeo.keywordIntro) %></p>
        <% } %>
        <% if (locSeo && locSeo.routeInfo) { %>
        <p style="margin-top:1rem"><strong>Getting here:</strong> <%= locSeo.routeInfo %></p>
        <% } %>
        <div class="loc-shop-details">
          <div class="loc-detail-item">
            <span class="loc-detail-label">Address</span>
            <span class="loc-detail-value"><a href="<%= site.directionsUrl %>" target="_blank" rel="noopener"><%= site.fullAddress %></a></span>
          </div>
          <div class="loc-detail-item">
            <span class="loc-detail-label">Hours</span>
            <span class="loc-detail-value"><%= site.hours %> · <%= site.sunHours %></span>
          </div>
          <% if (!location.isHome) { %>
          <div class="loc-detail-item">
            <span class="loc-detail-label">From <%= location.name %></span>
            <span class="loc-detail-value"><%= location.distance %> &mdash; about <%= location.driveTime %> drive</span>
          </div>
          <% } %>
        </div>
        <div class="loc-shop-actions">
          <a href="<%= site.directionsUrl %>" class="btn btn-primary" target="_blank" rel="noopener">Get Directions</a>
          <a href="tel:<%= site.phoneTel %>" class="btn btn-secondary">Call <%= site.phone %></a>
        </div>
      </div>
      <div class="loc-shop-map">
        <iframe
          src="https://maps.google.com/maps?q=144+W+Crystal+Ave,+South+Salt+Lake,+UT+84117&output=embed&hl=en&z=15"
          width="100%"
          height="100%"
          style="border:0;border-radius:10px;min-height:340px"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Scott's Auto and Clutch Location">
        </iframe>
      </div>
    </div>
  </div>
</section>

<!-- 2. About City — grey -->
<% if (location.aboutCity) { %>
<section class="content-section alt-bg">
  <div class="container">
    <h2>About <%= location.name %></h2>
    <div class="prose"><p><%= location.aboutCity %></p></div>
    <% if (location.neighborhoods && location.neighborhoods.length) { %>
    <div style="margin-top:1.5rem">
      <h3 style="font-size:1rem;margin-bottom:.75rem;color:var(--c-text-muted)">Neighborhoods We Serve in <%= location.name %></h3>
      <div class="brand-tags">
        <% location.neighborhoods.forEach(n => { %>
        <span class="tag"><%= n %></span>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- 3. Landmarks Near Our Shop — white -->
<% if (location.landmarks && location.landmarks.length) { %>
<section class="content-section">
  <div class="container">
    <h2>Landmarks Near Our Shop</h2>
    <p>Scott's Auto & Clutch is at <strong>144 W Crystal Ave, South Salt Lake, UT 84117</strong> — centrally located and easy to reach from across the Salt Lake Valley. Here are some well-known <%= location.name %> area landmarks and how they connect to our shop.</p>
    <div class="landmarks-grid">
      <% location.landmarks.forEach(lm => { %>
      <div class="landmark-card">
        <div class="landmark-header">
          <h3><%= lm.name %></h3>
          <span class="landmark-distance"><%= lm.distance %></span>
        </div>
        <% if (lm.description) { %>
        <p class="landmark-desc"><%= lm.description %></p>
        <% } %>
        <p class="landmark-tip"><%= lm.tip %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- 4. Combined Services Section — grey -->
<section class="content-section alt-bg">
  <div class="container">
    <h2>Auto Repair Services for <%= location.name %> Drivers</h2>
    <p>We handle everything from clutch repair and brake service to timing chains, CV axles, exhaust, and cooling systems — all makes and models, domestic and import.</p>
    <% if (locSeo && locSeo.commonNeeds && locSeo.commonNeeds.length) { %>
    <p style="margin-top:.5rem">Based on 35+ years of serving <%= location.name %> drivers, here are the repairs we're called on most often and why local driving conditions create the demand:</p>
    <div class="loc-common-needs">
      <% locSeo.commonNeeds.forEach(need => { %>
      <div class="loc-need-item">
        <strong><%- linkifyServices(need.service) %>:</strong> <%- linkifyServices(need.context) %>
      </div>
      <% }) %>
    </div>
    <% } %>
    <div class="services-grid small" style="margin-top:2rem">
      <% services.slice(0, 6).forEach(s => { %>
      <a href="/services/<%= s.slug %>" class="service-card">
        <h3><%= s.name %></h3>
        <p><%= s.shortDesc %></p>
        <span class="card-link">View service</span>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/services" class="btn btn-outline">View All Services</a>
    </div>
  </div>
</section>

<!-- 5. FAQ — white -->
<%- include('partials/faq') %>

<%- include('partials/testimonials') %>

<% var ctaTitle = "Need Auto Repair Near " + location.name + "?"; var ctaDesc = "Contact Scott's Auto and Clutch today for honest diagnostics and fair pricing." + (!location.isHome ? " We're just " + location.distance + " from " + location.name + "." : ""); %>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
