<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Symptoms Guide',url:'/symptoms'},{label:symptom.shortName}]}) %>

<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/assets/hero-600-DnXM3vMX.webp')"></div>
  <div class="container">
    <span class="symptom-priority priority-<%= symptom.priority.toLowerCase() %>"><%= symptom.priority %> Priority</span>
    <h1><%= symptom.name %> — Repair in South Salt Lake UT</h1>
    <p><%= symptom.intro %></p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<% if (relatedService) { %>
<section class="content-section">
  <div class="container">
    <h2>What's Causing Your <%= symptom.shortName %>?</h2>
    <div class="recommended-service-block">
      <p><%= symptom.serviceBlurb %> <a href="/services/<%= relatedService.slug %>">Learn more about our <%= relatedService.fullName %> service.</a></p>
      <div style="margin-top:1.25rem;display:flex;gap:.75rem;flex-wrap:wrap">
        <a href="/services/<%= relatedService.slug %>" class="btn btn-primary">Learn About This Service</a>
        <a href="tel:<%= site.phoneTel %>" class="btn btn-outline">Call for a Free Quote</a>
      </div>
    </div>
  </div>
</section>
<% } %>

<section class="content-section alt-bg">
  <div class="container">
    <h2>How We Handle <%= symptom.shortName %></h2>
    <div class="prose" style="max-width:720px">
      <p>Every repair starts with a free diagnosis — you describe what you're noticing and we inspect the vehicle. We walk you through exactly what we find, give you an upfront quote, and don't start work until you approve it. No surprises at pickup.</p>
      <% if (relatedService) { %>
      <p><a href="/services/<%= relatedService.slug %>">See how we approach <%= relatedService.name %> specifically</a>, including what the repair typically involves and how we keep you informed along the way.</p>
      <% } else { %>
      <p><a href="/services">View all services we offer</a> — if your symptom points to a specific repair, the service page covers our diagnostic approach in detail.</p>
      <% } %>
    </div>
  </div>
</section>

<% var faqAlt = false; %>
<%- include('partials/faq') %>

<section class="content-section alt-bg">
  <div class="container">
    <h2>Why <%= symptom.name %> Happens</h2>
    <p class="section-subtitle">These are the most common reasons drivers experience this symptom.</p>
    <div class="issues-grid">
      <% symptom.causes.forEach(c => { %>
      <div class="issue-card">
        <h3><%= c.title %></h3>
        <p><%= c.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <h2>Other Symptoms We Diagnose — Not Just <%= symptom.shortName %></h2>
    <p class="section-subtitle">Not sure if this is your issue? Browse other common problems we fix.</p>
    <div class="symptom-other-grid">
      <% allSymptoms.filter(s => s.slug !== symptom.slug).slice(0, 9).forEach(sy => { %>
      <a href="/symptoms/<%= sy.slug %>" class="symptom-other-card cat-<%= sy.category.toLowerCase().replace(' ','') %>">
        <span class="symptom-cat-chip"><%= sy.category %></span>
        <strong><%= sy.shortName %></strong>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/symptoms" class="btn btn-outline">View All Symptoms Guide</a>
    </div>
  </div>
</section>

<%- include('partials/testimonials') %>

<%- include('partials/cta') %>
<%- include('partials/footer') %>
