<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Symptoms Guide',url:'/symptoms'},{label:symptom.shortName}]}) %>

<section class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/assets/hero-600-DnXM3vMX.webp')"></div>
  <div class="container">
    <span class="symptom-priority priority-<%= symptom.priority.toLowerCase() %>"><%= symptom.priority %> Priority</span>
    <h1><%= symptom.name %> — Repair in South Salt Lake UT</h1>
    <% if (symptom.heroIntro) { %>
    <p class="hero-intro"><%= symptom.heroIntro %></p>
    <% } %>
    <% if (symptom.lastUpdated) { %>
    <p class="hero-meta">Last updated <%= symptom.lastUpdated %></p>
    <% } %>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<!-- What is X? -->
<section class="content-section">
  <div class="container">
    <div class="prose" style="max-width:760px">
      <h2>What Is <%= symptom.shortName %>?</h2>
      <p class="intro-lead"><%= symptom.intro %></p>
    </div>
  </div>
</section>

<!-- How to Tell (richContent[0]) -->
<% if (symptom.richContent && symptom.richContent.length > 0) { var sec0 = symptom.richContent[0]; %>
<section class="content-section alt-bg">
  <div class="container">
    <div class="prose" style="max-width:760px">
      <h2><%= sec0.heading %></h2>
      <% sec0.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec0.list && sec0.list.length) { %>
      <ul><% sec0.list.forEach(function(item) { %><li><%- item %></li><% }); %></ul>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- Why is my X? (causes grid) -->
<section class="content-section">
  <div class="container">
    <h2>Why Is My <%= symptom.shortName %>?</h2>
    <p class="section-subtitle">These are the most common causes. The "How to tell" note on each card describes what that cause typically feels or sounds like so you can narrow down which one applies to your vehicle.</p>
    <div class="issues-grid">
      <% symptom.causes.forEach(c => { %>
      <div class="issue-card">
        <h3><%= c.title %></h3>
        <p><%= c.desc %></p>
        <% if (c.diagnosticSignal) { %>
        <div class="diagnostic-signal">
          <span class="diagnostic-label">How to tell</span>
          <p><%= c.diagnosticSignal %></p>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <p class="inline-cta" style="margin-top:1.5rem">Not sure which applies to you? <a href="tel:<%= site.phoneTel %>">Call <%= site.phone %></a> or <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>">text us</a> — free diagnosis at our South Salt Lake shop.</p>
  </div>
</section>

<!-- When to Come In (richContent[1]) -->
<% if (symptom.richContent && symptom.richContent.length > 1) { var sec1 = symptom.richContent[1]; %>
<section class="content-section alt-bg">
  <div class="container">
    <div class="prose" style="max-width:760px">
      <h2><%= sec1.heading %></h2>
      <% sec1.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec1.list && sec1.list.length) { %>
      <ul><% sec1.list.forEach(function(item) { %><li><%- item %></li><% }); %></ul>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- Who to Trust (richContent[2]) -->
<% if (symptom.richContent && symptom.richContent.length > 2) { var sec2 = symptom.richContent[2]; %>
<section class="content-section">
  <div class="container">
    <div class="prose" style="max-width:760px">
      <h2><%= sec2.heading %></h2>
      <% sec2.paras.forEach(function(p) { %><p><%- p %></p><% }); %>
      <% if (sec2.list && sec2.list.length) { %>
      <ul><% sec2.list.forEach(function(item) { %><li><%- item %></li><% }); %></ul>
      <% } %>
    </div>
    <div class="hero-buttons" style="margin-top:1.5rem">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>?body=<%= encodeURIComponent(symptom.smsBody) %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>
<% } %>

<% var faqAlt = true; %>
<%- include('partials/faq') %>

<section class="content-section">
  <div class="container">
    <h2>Not Sure This Is Your Issue?</h2>
    <p class="section-subtitle">Browse related symptoms — drivers often confuse these for one another.</p>
    <div class="symptom-other-grid">
      <% relatedSymptoms.forEach(sy => { %>
      <a href="/symptoms/<%= sy.slug %>" class="symptom-other-card cat-<%= sy.category.toLowerCase().replace(' ','') %>">
        <span class="symptom-cat-chip"><%= sy.category %></span>
        <strong><%= sy.shortName %></strong>
      </a>
      <% }) %>
    </div>
    <div class="section-action">
      <a href="/symptoms" class="btn btn-outline">View All Symptoms Guide</a>
    </div>
  </div>
</section>

<%- include('partials/testimonials') %>

<%- include('partials/cta') %>
<%- include('partials/footer') %>
