<%- include('partials/header') %>

<%- include("partials/breadcrumbs", {breadcrumbs: [{label:'Home',url:'/'},{label:'Services'}]}) %>

<section class="page-hero">
  <style nonce="<%= cspNonce %>">.page-hero-bg{background-image:url('<%= site.heroImage %>')}</style>
  <div class="page-hero-bg"></div>
  <div class="container">
    <h1>Auto Repair Services</h1>
    <p>Auto repair in South Salt Lake, UT. We know clutch work inside and out, but we handle it all, brakes, exhaust, drivetrain, cooling, and more. All makes and models.</p>
    <div class="hero-buttons">
      <a href="tel:<%= site.phoneTel %>" class="btn btn-primary">Call Now: <%= site.phone %></a>
      <a href="sms:<%= site.phoneSms %>" class="btn btn-secondary">Text Us</a>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <% services.forEach((s, i) => { %>
    <div class="service-detail-card<%= i % 2 === 1 ? ' reverse' : '' %>">
      <div class="service-detail-text">
        <h2><%= s.name %></h2>
        <p><%= s.shortDesc %></p>
        <% if (s.specializedServices && s.specializedServices.length) { %>
        <div class="brand-tags mb-5">
          <% s.specializedServices.slice(0,6).forEach(item => { %>
          <span class="tag"><%= item %></span>
          <% }) %>
        </div>
        <% } %>
        <a href="/services/<%= s.slug %>" class="btn btn-primary">Learn More About <%= s.name %></a>
      </div>
      <div class="service-detail-image">
        <img src="<%= s.image %>" alt="<%= s.name %> service at Scott's Auto & Clutch Repair" loading="lazy" width="400" height="267">
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="content-section alt-bg">
  <div class="container">
    <h2>Clutch Repair Near You</h2>
    <p class="section-subtitle">We serve all of Salt Lake Valley from our South Salt Lake shop. Pick your city for directions, drive time, and local tips.</p>
    <div class="locations-grid-compact mt-5">
      <% allGeoPages.forEach(g => { %>
      <a href="/services/<%= g.slug %>" class="location-tag">
        <strong><%= g.locationName %></strong>
        <span><%= g.distance %> · <%= g.driveTime %> drive</span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="values-section alt-bg">
  <div class="container">
    <h2>Why Choose Scott's Auto & Clutch Repair</h2>
    <div class="values-grid">
      <% [
        { title: "35+ Years Experience", desc: "Over 35 years serving the Salt Lake Valley. We've worked on every make and most problems." },
        { title: "Free Diagnosis", desc: "Free check every time. We tell you what's wrong and what it will cost, before any work starts." },
        { title: "Transparent Pricing", desc: "Written estimate before we touch it. No hidden fees, no surprises at checkout." }
      ].forEach(v => { %>
      <div class="value-card">
        <h3><%= v.title %></h3>
        <p><%= v.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<% var ctaTitle = "Ready for Reliable Auto Repair?"; var ctaDesc = "Contact Scott's Auto & Clutch Repair today. We'll diagnose your vehicle and get you back on the road."; %>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
